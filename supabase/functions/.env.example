# Secrets des Edge Functions en LOCAL. Copier ce fichier en `.env` (jamais versionné), puis :
#   supabase functions serve --env-file supabase/functions/.env
# Sur le cloud, utiliser `supabase secrets set NOM=valeur` (voir docs/configuration.md).
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont fournis automatiquement : ne pas les définir.

# Clé de l'API Claude (Anthropic). Obligatoire pour toute génération.
ANTHROPIC_API_KEY=

# Secret partagé avec RevenueCat (en-tête Authorization: Bearer <secret> du webhook).
REVENUECAT_WEBHOOK_SECRET=

# Clé secrète de l'API RevenueCat : efface le client RevenueCat à la suppression d'un compte.
REVENUECAT_SECRET_API_KEY=

# "true" pour accepter les achats de test (sandbox). Jamais en production publiée.
REVENUECAT_ALLOW_SANDBOX=

# Code d'accès Premium pour la revue des stores (ADR-031) : empreinte SHA-256 du code en
# majuscules sans tirets, jamais le code lui-même. Vide : aucun code accepté.
REVIEW_ACCESS_CODE_SHA256=
# Nombre maximal d'activations par code (20 par défaut).
REVIEW_ACCESS_MAX_REDEMPTIONS=20

# Blocs AdMob « récompensée » autorisés à créditer, séparés par des virgules
# (partie après « / » de l'identifiant). Vide : aucun contrôle (développement uniquement).
ADMOB_AD_UNIT_IDS=
